FROM python:3.13-slim

# Create non-root user for security
RUN useradd --create-home workeruser
WORKDIR /app
RUN chown workeruser:workeruser /app

ENV PYTHONPATH=/app

COPY pyproject.toml .

RUN pip install --no-cache-dir .

COPY --chown=workeruser:workeruser . .

USER workeruser

CMD ["python", "-c", "from src.worker import main; main()"]